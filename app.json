{
  "expo": {
    "name": "コンビニ貯金",
    "slug": "konbini-chokin",
    "scheme": "konbinichokin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF7E8"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.konbinichokin.app",
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.konbinichokin.app"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF7E8"
      },
      "package": "com.konbinichokin.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-apple-targets",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "SavingsWidget",
              "label": "コンビニ貯金",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "description": "貯金額と育成中のキャラクターを表示します",
              "previewImage": "./assets/widget-preview.png",
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical"
            }
          ]
        }
      ]
    ],
    "extra": {
      "iosAppGroup": "group.com.konbinichokin.app"
    }
  }
}
